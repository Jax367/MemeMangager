<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="拾趣 · 图片预处理" Width="760" Height="730" MinWidth="650" MinHeight="600" WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" FontSize="12" Background="{DynamicResource Canvas}" AllowDrop="True" UseLayoutRounding="True">
 <Grid Margin="22,16,22,14" Background="{DynamicResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="图片预处理" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="其它图片转 GIF · FFmpeg 批处理 · 保留原图" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource Tint}" CornerRadius="4" Padding="10,5" VerticalAlignment="Center"><TextBlock Text="按需启动" Foreground="{DynamicResource Muted}" FontSize="11"/></Border></Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Configuration" Margin="0,0,8,0">
   <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="14"><StackPanel>
    <DockPanel><TextBlock Text="01   待处理图片" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="QueueCount" Text="0 个文件" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/></DockPanel>
    <StackPanel Orientation="Horizontal" Margin="0,12,0,9"><Button x:Name="AddFiles" Content="＋ 添加图片" Margin="0,0,7,0"/><Button x:Name="AddFolder" Content="添加文件夹" Margin="0,0,7,0"/><Button x:Name="Clear" Content="清空"/><CheckBox x:Name="Recursive" Content="包含子文件夹" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Ink}"/></StackPanel>
    <ListBox x:Name="Queue" Height="100" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" FontSize="11" Padding="5,2"/></DataTemplate></ListBox.ItemTemplate></ListBox>
    <TextBlock Text="可拖入图片或文件夹。开启保留动图后，原 GIF 原样保留，动态图片保留各帧。" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
   </StackPanel></Border>
   <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,10,0,0"><StackPanel>
    <TextBlock Text="02   格式与规格" FontWeight="SemiBold"/>
    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="Format" SelectedIndex="0"><ComboBoxItem Content="GIF · 保留动画"/><ComboBoxItem Content="PNG / APNG"/><ComboBoxItem Content="JPEG · 白底"/><ComboBoxItem Content="WebP · 无损"/><ComboBoxItem Content="BMP · 白底"/><ComboBoxItem Content="保持原格式"/></ComboBox><CheckBox Grid.Column="1" x:Name="ResizeEnabled" Content="统一尺寸" IsChecked="True" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid>
    <CheckBox x:Name="PreserveAnimation" Content="保留动图（原 GIF 原样保留并可导入，不调整原 GIF 尺寸）" IsChecked="True" Foreground="{DynamicResource Ink}" Margin="0,10,0,0"/><Grid x:Name="ResizeOptions" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="25"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="Width" Text="256" ToolTip="宽度 / 像素"/><TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><TextBox x:Name="Height" Grid.Column="2" Text="256" ToolTip="高度 / 像素"/><ComboBox x:Name="Fit" Grid.Column="3" Margin="12,0,0,0" SelectedIndex="0"><ComboBoxItem Content="等比留边 · 完整保留"/><ComboBoxItem Content="居中裁切 · 填满画布"/><ComboBoxItem Content="拉伸至指定尺寸"/></ComboBox></Grid>
    <TextBlock Text="GIF 保留动画、最多 256 色；JPEG / BMP 不支持动图，开启保留时会跳过。" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,9,0,0"/>
   </StackPanel></Border>
   <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,10,0,0"><StackPanel>
    <TextBlock Text="03   保存与工具" FontWeight="SemiBold"/>
    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Output" ToolTip="输出目录：不覆盖原文件，同名自动编号"/><Button x:Name="ChooseOutput" Grid.Column="1" Content="输出目录" Margin="8,0,0,0"/></Grid>
    <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Ffmpeg" ToolTip="ffmpeg.exe 路径：自动从程序目录、tools 和 PATH 查找"/><Button x:Name="ChooseFfmpeg" Grid.Column="1" Content="FFmpeg" Margin="8,0,0,0"/></Grid>
   </StackPanel></Border>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,12,0,0"><ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="1"/><TextBlock x:Name="Status" Text="仅在点击开始后启动 FFmpeg，关闭此窗口后工具进程退出。" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,9,0,9"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="OpenOutput" Content="打开输出" HorizontalAlignment="Left"/><Button x:Name="Cancel" Grid.Column="1" Content="取消处理" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="Start" Grid.Column="2" Content="开始批处理" Background="{DynamicResource Accent}" Foreground="White" Padding="22,8"/></Grid><DockPanel Margin="0,10,0,0"><Button x:Name="ImportResults" DockPanel.Dock="Right" Content="一键导入收藏库" IsEnabled="False" Background="{DynamicResource Accent}" Foreground="White" Padding="16,8"/><TextBlock Text="导入到" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="ImportGroup" Width="170" HorizontalAlignment="Left" VerticalAlignment="Center"/></DockPanel></StackPanel>
 </Grid>
</Window>
