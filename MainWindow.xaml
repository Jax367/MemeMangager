<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="拾趣 · 表情管理与设置" Width="1040" Height="700" MinWidth="800" MinHeight="520" WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" FontFamily="Microsoft YaHei UI" FontSize="12" UseLayoutRounding="True" AllowDrop="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Canvas" Color="#EFF0F2"/><SolidColorBrush x:Key="Surface" Color="#FAFAFB"/><SolidColorBrush x:Key="Ink" Color="#303640"/><SolidColorBrush x:Key="Muted" Color="#707985"/><SolidColorBrush x:Key="Line" Color="#D9DDE3"/><SolidColorBrush x:Key="Accent" Color="#627792"/><SolidColorBrush x:Key="Tint" Color="#DCE3EC"/><SolidColorBrush x:Key="Side" Color="#E6E8EC"/><SolidColorBrush x:Key="SideInk" Color="#4A5565"/><SolidColorBrush x:Key="SideMuted" Color="#737D8A"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Canvas}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CaretBrush" Value="{DynamicResource Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,6"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Padding" Value="10,6"/><Setter Property="MinWidth" Value="110"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5"><TextBlock Text="⌄" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,3"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,6,27,6" VerticalAlignment="Center"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="3"><ScrollViewer MaxHeight="280"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="8,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="B" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Tint}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Tint}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Nav" TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource SideInk}"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="B" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" BorderThickness="2,0,0,0" BorderBrush="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Tint}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Tint}"/><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Background="{DynamicResource Wallpaper}">
  <Grid.RowDefinitions><RowDefinition Height="57"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><Grid Margin="18,0,18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="BrandIcon" Width="28" Height="28" Margin="0,0,9,0"/><StackPanel><TextBlock Text="拾趣" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="MEME LIBRARY" Foreground="{DynamicResource Muted}" FontSize="8" Margin="0,1,0,0"/></StackPanel></StackPanel>
   <Grid Grid.Column="1" Margin="0,11,20,11"><TextBox x:Name="Search" ToolTip="搜索表情名称"/><TextBlock x:Name="SearchHint" Text="⌕   搜索表情…" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0"/></Grid>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="OpenPicker" Content="选择表情" Margin="0,0,8,0"/><Button x:Name="ImportClipboard" Content="从剪贴板添加" ToolTip="导入剪贴板中的图片或图片文件到当前分组" Margin="0,0,8,0"/><Button x:Name="ImportFolder" Content="导入文件夹" Margin="0,0,8,0"/><Button x:Name="ImportFiles" Content="＋  添加表情" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}" Foreground="White"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"><Grid Margin="10,16,10,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="资料库" Foreground="{DynamicResource SideMuted}" FontSize="10" Margin="12,0,0,8"/><ListBox x:Name="Navigation" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Nav}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,22,0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="12,0,4,7"><Button x:Name="AddGroup" DockPanel.Dock="Right" Content="＋" ToolTip="新建分组" Foreground="{DynamicResource SideInk}" Background="Transparent" BorderThickness="0" Padding="5,0"/><TextBlock Text="分组" Foreground="{DynamicResource SideMuted}" FontSize="10" VerticalAlignment="Center"/></DockPanel><ListBox x:Name="Groups" Grid.Row="1" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Nav}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></Grid>
    <StackPanel Grid.Row="2"><Button x:Name="PreprocessButton" Content="⌘   图片预处理" Background="Transparent" Foreground="{DynamicResource SideInk}" BorderThickness="0" Padding="10,8"/><Button x:Name="SettingsButton" Content="⚙   外观与偏好" Background="Transparent" Foreground="{DynamicResource SideInk}" BorderThickness="0" Padding="10,8"/></StackPanel>
   </Grid></Border>
   <Grid Grid.Column="1" Margin="18,0,10,0"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="全部表情" FontSize="17" FontWeight="SemiBold"/><Border Background="{DynamicResource Tint}" CornerRadius="3" Margin="10,0,0,0" Padding="6,3"><TextBlock Text="本地资料库" Foreground="{DynamicResource Muted}" FontSize="9"/></Border></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="BatchToggle" Content="批量分组" Margin="0,0,8,0"/><ComboBox x:Name="Sort" SelectedIndex="0" VerticalAlignment="Center"><ComboBoxItem Content="使用最多"/><ComboBoxItem Content="最近添加"/><ComboBoxItem Content="最近使用"/><ComboBoxItem Content="名称排序"/></ComboBox></StackPanel></Grid>
    <Border x:Name="BatchBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,8,10"><WrapPanel VerticalAlignment="Center"><TextBlock x:Name="BatchCount" Text="已选 0 张" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/><Button x:Name="BatchSelectAll" Content="全选当前结果" Padding="8,6" Margin="0,0,6,0"/><Button x:Name="BatchClear" Content="清空" Padding="8,6" Margin="0,0,10,0"/><ComboBox x:Name="BatchGroup" MinWidth="120" MaxWidth="180" Margin="0,0,6,0"/><Button x:Name="BatchMove" Content="加入分组" Padding="10,6" Background="{DynamicResource Accent}" Foreground="White"/></WrapPanel></Border>
    <Grid Grid.Row="2"><ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,8"><WrapPanel x:Name="Cards"/></ScrollViewer><StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40"><Border Background="{DynamicResource Tint}" CornerRadius="12" Width="52" Height="52" HorizontalAlignment="Center"><TextBlock Text="▦" FontSize="27" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="EmptyTitle" Text="添加第一张表情" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" Margin="0,16,0,8"/><TextBlock x:Name="EmptyHint" Text="拖入图片或文件夹，建立你的本地表情库" Foreground="{DynamicResource Muted}" TextAlignment="Center"/><Button x:Name="EmptyImport" Content="＋  添加表情" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}" Foreground="White" Margin="0,18,0,0" HorizontalAlignment="Center"/></StackPanel></Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><Grid Margin="14,0,16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="点击复制并收起  ·  GIF 悬停播放" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,22,0"/><TextBlock x:Name="ShortcutHint" Foreground="{DynamicResource Muted}" FontSize="10"/></StackPanel></Grid></Border>
 </Grid>
</Window>
